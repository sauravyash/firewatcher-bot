# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=
GUILD_ID=
# Given to anyone who links at least one character
VERIFIED_ROLE_ID=
# Optional: given only when a linked character is in an allowed corp/alliance
CORP_MEMBER_ROLE_ID=
# Comma-separated EVE ids. Leave both empty to treat every verified character as allowed.
ALLOWED_CORPORATIONS=
ALLOWED_ALLIANCES=
# Optional faction warfare roles, given on top of the others when a character's corp is enlisted
# in that side's militia (including the NPC militia corps that solo pilots join):
#   Amarr side    = Amarr Empire + Caldari State
#   Gallente side = Gallente Federation + Minmatar Republic
AMARR_MILITIA_ROLE_ID=
GALLENTE_MILITIA_ROLE_ID=
# "any" = a role applies if ANY linked character (main or alt) qualifies; "main" = only the main counts
ROLES_FROM=any

# --- Nicknames ---
SET_NICKNAMES=true
# Placeholders: {name} {corp} {alliance}. Discord truncates at 32 characters.
NICK_FORMAT=[{corp}] {name}

# --- EVE SSO (https://developers.eveonline.com/applications) ---
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
# Must exactly match the callback URL registered on your EVE application
# Local testing: http://localhost:8080/callback   Production: https://firewatcher-bot.yaa.sh/callback
EVE_CALLBACK_URL=http://localhost:8080/callback
# Sent in the ESI User-Agent so CCP can contact you if the bot misbehaves
CONTACT_EMAIL=

# --- Runtime ---
WEB_PORT=8080
DB_PATH=firewatcher-bot.db
SYNC_MINUTES=60
